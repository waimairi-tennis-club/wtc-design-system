// Cloudflare settings for the reference site: static files only, no Worker code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wtc-design-system",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  // Draft branches get their own preview address (Workers Builds runs `wrangler preview`).
  "previews": {}
}
