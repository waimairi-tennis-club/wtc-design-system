---
// A square button with an icon: phone and email next to a contact, or social links in the footer.
//   <IconButton icon="phone" href="tel:0210223765" label="Call Cassandra" />
import Icon, { type IconName } from './Icon.astro';
import './components.css';

interface Props {
  icon: IconName;
  href: string;
  /** What the button does, read out by screen readers, e.g. "Email Cassandra". */
  label: string;
  /** blue (the default) or white. */
  color?: 'blue' | 'white';
  /** Opens in a new tab. Defaults to true for links to other websites. */
  external?: boolean;
}
const { icon, href, label, color = 'blue' } = Astro.props;
const external = Astro.props.external ?? /^https?:\/\//.test(href);
---
<a href={href} class="wtc-icon-button" data-color={color} aria-label={label} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <Icon name={icon} />
</a>
