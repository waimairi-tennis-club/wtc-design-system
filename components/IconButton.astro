---
// A square button with a phone or email icon, e.g. next to a contact's details.
//   <IconButton icon="phone" href="tel:0210223765" label="Call Cassandra" />
import './components.css';

interface Props {
  icon: 'phone' | 'email';
  href: string;
  /** What the button does, read out by screen readers, e.g. "Email Cassandra". */
  label: string;
  /** blue (on light backgrounds) or white (on dark backgrounds). */
  color?: 'blue' | 'white';
}
const { icon, href, label, color = 'blue' } = Astro.props;
---
<a href={href} class="wtc-icon-button" data-color={color} aria-label={label}>
  {icon === 'phone' && (
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.38 8.85a13 13 0 0 0 2.85 4.01 13 13 0 0 0 4.01 2.85c.12.06.19.09.27.11.28.08.62.02.86-.15.07-.05.12-.1.24-.22.35-.35.52-.52.7-.64a2 2 0 0 1 2.18 0c.18.12.35.29.7.64l.2.2c.53.53.8.8.94 1.08.29.57.29 1.24 0 1.8-.14.29-.41.56-.94 1.09l-.16.16c-.53.53-.8.8-1.15 1a3.3 3.3 0 0 1-1.48.38c-.41 0-.7-.08-1.26-.24A19 19 0 0 1 8.04 16.05 19 19 0 0 1 3.17 7.76c-.16-.56-.24-.85-.24-1.26 0-.46.16-1.08.38-1.48.2-.36.47-.62 1-1.15l.16-.16c.53-.53.8-.8 1.08-.94a2 2 0 0 1 1.81 0c.29.14.55.41 1.08.94l.2.2c.35.35.52.52.64.7a2 2 0 0 1 0 2.18c-.12.18-.29.35-.64.7-.11.11-.17.17-.22.24-.17.24-.23.58-.15.86.02.08.05.14.11.27Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  )}
  {icon === 'email' && (
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21.5 18L14.8571 12M9.14286 12L2.50003 18M2 7L10.1649 12.7154C10.8261 13.1783 11.1567 13.4097 11.5163 13.4993C11.8339 13.5785 12.1661 13.5785 12.4837 13.4993C12.8433 13.4097 13.1739 13.1783 13.8351 12.7154L22 7M6.8 20H17.2C18.8802 20 19.7202 20 20.362 19.673C20.9265 19.3854 21.3854 18.9265 21.673 18.362C22 17.7202 22 16.8802 22 15.2V8.8C22 7.11984 22 6.27976 21.673 5.63803C21.3854 5.07354 20.9265 4.6146 20.362 4.32698C19.7202 4 18.8802 4 17.2 4H6.8C5.11984 4 4.27976 4 3.63803 4.32698C3.07354 4.6146 2.6146 5.07354 2.32698 5.63803C2 6.27976 2 7.11984 2 8.8V15.2C2 16.8802 2 17.7202 2.32698 18.362C2.6146 18.9265 3.07354 19.3854 3.63803 19.673C4.27976 20 5.11984 20 6.8 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  )}
</a>
