---
// A sponsor's logo on their own background colour. Links to their website if there is one.
//   <SponsorLogo logo="/davis-ogilvie.svg" alt="Davis Ogilvie" background="#191818" href="https://do.co.nz" />
import './components.css';

interface Props {
  logo: string;
  alt: string;
  /** The sponsor's background colour. Default white. */
  background?: string;
  href?: string;
}
const { logo, alt, background = 'white', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="wtc-sponsor" style={`background-color: ${background}`} {...(href ? { href, target: '_blank', rel: 'noopener' } : {})}>
  <img src={logo} alt={alt} loading="lazy" />
</Tag>
