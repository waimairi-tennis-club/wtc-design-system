---
// The square "back to top" button in the bottom-right corner. Appears while scrolling down a page
// and hides when scrolling back up (as on the Webflow site). Put it once per page.
import Icon from './Icon.astro';
import './components.css';

interface Props {
  /** Show it in place and always visible (for documentation). */
  static?: boolean;
}
const { static: isStatic = false } = Astro.props;
---
<a href="#top" class="wtc-back-to-top" data-static={isStatic || undefined} aria-label="Back to top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;"><Icon name="arrow-up" /></a>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('.wtc-back-to-top:not([data-static])');
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    for (const b of buttons) {
      if (y < 200) b.classList.remove('is-visible');
      else if (y > lastY) b.classList.add('is-visible');
      else if (y < lastY) b.classList.remove('is-visible');
    }
    lastY = y;
  }, { passive: true });
</script>
