---
// The shell for every page of the reference site: head, the dark header with page links, and shared styles.
import { Font } from 'astro:assets';
import whiteLogo from '../../assets/logos/wtc-white-logo.svg?url';
import '../../tokens/tokens.css';

interface Props {
  title: string;
  intro: string;
  /** Jump links to the sections on this page. */
  sections: { id: string; label: string }[];
}
const { title, intro, sections } = Astro.props;
const pages = [
  { href: '/', label: 'Foundations' },
  { href: '/components', label: 'Components' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · WTC design system</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-barlow" preload />
  </head>
  <body>
    <header class="hero">
      <div class="hero-top">
        <a href="/"><img src={whiteLogo} alt="Waimairi Tennis Club design system" class="hero-logo" /></a>
        <nav class="pages">
          {pages.map(p => <a href={p.href} aria-current={p.href === here ? 'page' : undefined}>{p.label}</a>)}
        </nav>
      </div>
      <h1>{title}</h1>
      <p set:html={intro} />
      <nav class="sections">
        {sections.map(s => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-off-white);
    line-height: var(--leading-medium);
  }
  h1, h2, h3, h4 { font-family: var(--font-heading); color: var(--color-heading); line-height: var(--leading-small); }
  code { font-size: var(--text-12); color: var(--color-info-text); }

  .hero {
    background: var(--wtc-blue-900);
    color: var(--color-text-on-dark);
    padding: var(--space-40) var(--space-24);
  }
  .hero > * { max-width: 1100px; margin-inline: auto; }
  .hero-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-16); flex-wrap: wrap; }
  .hero-logo { display: block; height: 48px; }
  .hero h1 { color: var(--color-white); font-size: var(--text-48); margin-block: var(--space-40) var(--space-12); }
  .hero p { font-size: var(--text-18); max-width: 640px; margin-left: 0; }
  .hero code { color: var(--wtc-blue-200); font-size: inherit; }
  .pages { display: flex; gap: var(--space-4); }
  .pages a { color: var(--wtc-steel-300); text-decoration: none; font-weight: var(--weight-medium); padding: var(--space-6) var(--space-12); }
  .pages a:hover, .pages a[aria-current] { color: var(--color-white); }
  .pages a[aria-current] { box-shadow: inset 0 -2px 0 var(--wtc-blue-400); }
  .sections { display: flex; flex-wrap: wrap; gap: var(--space-8); margin-top: var(--space-30); }
  .sections a {
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--weight-medium);
    padding: var(--space-6) var(--space-14);
    border: 1px solid var(--wtc-blue-600);
    border-radius: 999px;
  }
  .sections a:hover { background: var(--wtc-blue-700); }

  main { max-width: 1100px; margin: 0 auto; padding: 0 var(--space-24) var(--space-80); }
  main > section { padding-top: var(--space-60); }
  main h2 { font-size: var(--text-36); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-12); }
  main h3 { font-size: var(--text-22); margin-top: var(--space-40); }
  main h4 { font-size: var(--text-16); margin-bottom: var(--space-8); }
  .note { color: var(--color-info-text); max-width: 720px; }

  .grid { display: grid; gap: var(--space-16); }
  .tile {
    margin: 0;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--space-20);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }
  .tile.dark { background: var(--wtc-blue-900); }
  .tile.dark figcaption { color: var(--wtc-steel-300); }
  figcaption { font-size: var(--text-12); color: var(--color-info-text); word-break: break-all; text-align: center; }

  @media (max-width: 767px) {
    .hero h1 { font-size: var(--text-36); }
  }
</style>
