---
// The shell for every page of the reference site. It's built from the design system's own
// Header, PageHero and Footer, so it looks exactly like www.wtc.co.nz.
import { Font } from 'astro:assets';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import BackToTop from '../../components/BackToTop.astro';
import '../../tokens/tokens.css';

interface Props {
  title: string;
  intro: string;
  /** Jump links to the sections on this page. */
  sections: { id: string; label: string }[];
}
const { title, intro, sections } = Astro.props;
const pages = [
  { label: 'Foundations', href: '/' },
  { label: 'Components', href: '/components' },
  { label: 'Page sections', href: '/sections' },
];
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · WTC design system</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-barlow" preload />
  </head>
  <body id="top">
    <Header menu={pages} cta={{ href: 'https://www.wtc.co.nz', text: 'Website' }} logoAlt="Waimairi Tennis Club design system home" />
    <PageHero image="/images/hero.avif" label="WTC design system" title={title} intro={intro} width="wide">
      {sections.map(s => <Button href={`#${s.id}`} color="white" hover="blue" size="small">{s.label}</Button>)}
    </PageHero>
    <main><slot /></main>
    <Footer
      about={['The club’s logos, colours, type and components, so everything we make looks like it belongs together.']}
      columns={[{ title: 'Design system', links: pages }, { title: 'Club', links: [{ label: 'wtc.co.nz', href: 'https://www.wtc.co.nz' }, { label: 'Membership', href: 'https://www.wtc.co.nz/membership' }] }]}
    />
    <BackToTop />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { scroll-padding-top: 120px; }
  /* Jump buttons glide down to their section (unless the visitor has asked for less motion) */
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
  body {
    margin: 0;
    padding: 10px;
    background: var(--color-off-white);
    font-family: var(--font-body);
    font-size: var(--text-18);
    line-height: var(--leading-large);
    letter-spacing: 0.13px;
    color: var(--color-text);
  }
  body > .wtc-page-hero { margin-bottom: 10px; }
  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    font-weight: var(--weight-medium);
    color: var(--wtc-blue-950);
    line-height: var(--leading-small);
    letter-spacing: -1.4px;
  }
  h4 { letter-spacing: 0; }
  code { font-size: 0.8em; color: var(--color-info-text); }
  .wtc-page-hero code { color: var(--wtc-blue-200); font-size: inherit; }

  /* Page blocks: white sections on the pale frame */
  /* The side padding grows on wide screens so everything inside sits in the same 1200px column */
  main > section {
    background: var(--color-white);
    margin-bottom: 10px;
    padding: 90px max(var(--space-30), calc((100% - 1200px) / 2));
  }
  main h2 { font-size: var(--text-48); margin-block: var(--space-12) var(--space-20); }
  main h3 { font-size: var(--text-26); letter-spacing: -0.5px; margin-block: var(--space-50) var(--space-16); }
  main h4 { font-size: var(--text-18); font-weight: var(--weight-semibold); margin-block: var(--space-30) var(--space-10); }
  main p { max-width: 680px; }
  .note { margin-bottom: var(--space-20); }
  .note > * { max-width: 680px; }

  .grid { display: grid; gap: var(--space-14); }
  .tile {
    margin: 0;
    background: var(--color-off-white);
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }
  .tile.dark { background: var(--wtc-blue-900); }
  .tile.dark figcaption { color: var(--wtc-steel-300); }
  figcaption { font-size: var(--text-12); line-height: 1.5; color: var(--color-info-text); word-break: break-all; text-align: center; letter-spacing: 0; }

  /* Examples and code */
  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-30);
    padding: var(--space-30);
    background: var(--color-off-white);
    margin-bottom: var(--space-16);
  }
  .demo.dark { background: var(--wtc-blue-900); }
  .demo.dark figcaption { color: var(--wtc-steel-300); }
  .demo.grey { background: var(--wtc-steel-200); }
  .demo.white { background: var(--color-white); padding: 0; }
  .demo.bottom { align-items: flex-end; }
  .demo.top { align-items: flex-start; gap: var(--space-60); }
  .demo.flush { display: block; padding: 0; background: none; }
  .demo figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-10); }
  .demo figure.wide { flex: 1 1 260px; align-items: stretch; }
  .demo figcaption { font-family: ui-monospace, monospace; }
  pre { background: var(--wtc-blue-950); color: var(--wtc-blue-100); padding: var(--space-20); overflow-x: auto; }
  pre code { color: inherit; font-size: var(--text-14); }

  @media (max-width: 991px) {
    main > section { padding: 70px var(--space-24); }
  }
  @media (max-width: 767px) {
    main h2 { font-size: var(--text-36); }
    main > section { padding: 60px var(--space-20); }
  }
</style>
