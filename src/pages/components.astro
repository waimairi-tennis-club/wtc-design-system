---
// Components: every component with live examples and how to use it.
import Docs from '../layouts/Docs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import IconButton from '../../components/IconButton.astro';
import Avatar from '../../components/Avatar.astro';
import EventCard from '../../components/EventCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import PersonCard from '../../components/PersonCard.astro';
import MembershipCard from '../../components/MembershipCard.astro';
import Subtitle from '../../components/Subtitle.astro';
import InfoBox from '../../components/InfoBox.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import SponsorLogo from '../../components/SponsorLogo.astro';

const colours = ['blue', 'dark', 'white'] as const;
const buttonsOnLight = [
  { color: 'blue', hover: 'dark', old: 'blue-to-black' },
  { color: 'dark', hover: 'blue', old: 'black-to-blue' },
] as const;
const buttonsOnDark = [
  { color: 'white', hover: 'blue', old: 'white-to-blue' },
  { color: 'white', hover: 'dark', old: 'white-to-black' },
  { color: 'blue', hover: 'white', old: 'blue-to-white' },
  { color: 'dark', hover: 'white', old: 'black-to-white' },
] as const;
const avatarSizes = [
  { size: 'xs', px: 40, use: 'Lists, comments' },
  { size: 'sm', px: 90, use: 'Contact blocks' },
  { size: 'md', px: 120, use: '' },
  { size: 'lg', px: 160, use: 'Coach grid' },
  { size: 'xl', px: 220, use: 'Featured coach' },
] as const;
---
<Docs
  title="Components"
  intro="The building blocks the website is made from. Hover over them to see them move. Each one is plain HTML and CSS underneath (<code>components/components.css</code>), so it works anywhere."
  sections={[{ id: 'button', label: 'Button' }, { id: 'icon-button', label: 'Icon button' }, { id: 'avatar', label: 'Avatar' }, { id: 'event-card', label: 'Event card' }, { id: 'news-card', label: 'News card' }, { id: 'person-card', label: 'Person card' }, { id: 'membership-card', label: 'Membership card' }, { id: 'subtitle', label: 'Subtitle' }, { id: 'info-box', label: 'Info box' }, { id: 'filter', label: 'Category filter' }, { id: 'sponsor', label: 'Sponsor logo' }]}
>
  <section id="button">
    <SectionHeading label="Components" title="Button" />
    <p class="note">The club's main call to action: uppercase text with a small arrow. On hover the arrow slides away and the colour changes. Pick a resting <strong>color</strong> and a <strong>hover</strong> colour that stands out from the background.</p>

    <h3>On light backgrounds</h3>
    <div class="demo light">
      {buttonsOnLight.map(b => (
        <figure><Button href="#button" color={b.color} hover={b.hover}>More info</Button><figcaption>color="{b.color}" hover="{b.hover}"<br />was {b.old}</figcaption></figure>
      ))}
    </div>

    <h3>On dark backgrounds</h3>
    <div class="demo dark">
      {buttonsOnDark.map(b => (
        <figure><Button href="#button" color={b.color} hover={b.hover}>Join now</Button><figcaption>color="{b.color}" hover="{b.hover}"<br />was {b.old}</figcaption></figure>
      ))}
    </div>

    <h3>Sizes and widths</h3>
    <div class="demo light">
      <figure><Button href="#button">Normal</Button><figcaption>size="normal"</figcaption></figure>
      <figure><Button href="#button" size="small">Small</Button><figcaption>size="small" (new)</figcaption></figure>
      <figure class="wide"><Button href="#button" full>Full width</Button><figcaption>full</figcaption></figure>
    </div>

    <h4>Use it</h4>
    <pre><code>{`<Button href="/membership">Join now</Button>
<Button href="https://forms.gle/…" color="white" hover="blue">RSVP</Button>

<!-- Plain HTML -->
<a class="wtc-button" data-color="blue" data-hover="dark" href="/membership">
  <span class="wtc-button__text">Join now</span>
  <svg class="wtc-button__arrow" viewBox="0 0 4 8"><path d="M4 4 0 8V0z" fill="currentColor"/></svg>
</a>`}</code></pre>
    <p class="note">Links to other websites open in a new tab automatically. Without an <code>href</code> it becomes a real button, for forms.</p>
  </section>

  <section id="icon-button">
    <SectionHeading label="Components" title="Icon button" />
    <p class="note">Square phone and email buttons, shown next to a contact's details.</p>
    <div class="demo light">
      <figure><IconButton icon="phone" href="#icon-button" label="Call" /><figcaption>phone</figcaption></figure>
      <figure><IconButton icon="email" href="#icon-button" label="Email" /><figcaption>email</figcaption></figure>
    </div>
    <div class="demo dark">
      <figure><IconButton icon="phone" href="#icon-button" label="Call" color="white" /><figcaption>color="white"</figcaption></figure>
      <figure><IconButton icon="email" href="#icon-button" label="Email" color="white" /><figcaption>color="white"</figcaption></figure>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<IconButton icon="phone" href="tel:0210223765" label="Call Cassandra" />`}</code></pre>
  </section>

  <section id="avatar">
    <SectionHeading label="Components" title="Avatar" />
    <p class="note">A person's photo. Square, like the rest of the site. When there's no photo it shows their initials on a light blue tile, so nobody is left with a blank space or someone else's picture.</p>

    <h3>Sizes</h3>
    <div class="demo light bottom">
      {avatarSizes.map(a => (
        <figure><Avatar name="Rhys" src="/examples/rhys-picture.avif" size={a.size} /><figcaption>{a.size} · {a.px}px{a.use && <><br />{a.use}</>}</figcaption></figure>
      ))}
    </div>

    <h3>No photo</h3>
    <div class="demo light bottom">
      {avatarSizes.map(a => (
        <figure><Avatar name="Cassandra Hinton" size={a.size} /><figcaption>{a.size}</figcaption></figure>
      ))}
    </div>

    <h3>Round (new)</h3>
    <div class="demo light bottom">
      <figure><Avatar name="Rhys" src="/examples/rhys-picture.avif" size="sm" shape="round" /><figcaption>shape="round"</figcaption></figure>
      <figure><Avatar name="Cassandra Hinton" size="sm" shape="round" /><figcaption>shape="round"</figcaption></figure>
      <figure><Avatar name="Glen Duffield" size="xs" shape="round" /><figcaption>xs, round</figcaption></figure>
    </div>

    <h4>Use it</h4>
    <pre><code>{`<Avatar name="Cassandra Hinton" src={photo} size="sm" />
<Avatar name="Cassandra Hinton" />   <!-- initials -->`}</code></pre>
  </section>

  <section id="event-card">
    <SectionHeading label="Components" title="Event card" />
    <p class="note">An event in a list. Made for grey backgrounds: the text sits in a white box. The buttons change with the event: an entry or RSVP button, an orange countdown while entries are open, an orange "closed" box once they shut, and MORE INFO when the event has its own page.</p>
    <div class="cards grey">
      <EventCard href="#event-card" title="Senior Members Christmas Party" when="Wed, 9 December 2026, 6:00 pm — 8:00 pm" summary="Join us to celebrate Christmas and the first half of the 2026/27 tennis season." image="/examples/christmas-party.webp" entry={{ href: '#event-card', text: 'RSVP' }} moreInfo={false} />
      <EventCard href="#event-card" title="Matariki Masters Tournament" when="Fri, 10 July 2026 — Sun, 12 July 2026" summary="Presented by Waimairi Tennis Club and Davis Ogilvie, we are delighted to be part of the 2026 Masters Tournament Calendar." image="/examples/matariki.avif" entry={{ href: '#event-card', text: 'Enter now' }} countdown="5 days left to enter" />
      <EventCard href="#event-card" title="Senior Doubles Club Champs" when="Wed, 16 September 2026 — Sun, 22 November 2026" summary="Our annual Senior Doubles Club Champs. Entries close 15 September, with finals on Friday 20 or Sunday 22 November 2026." closed />
    </div>
    <h4>Use it</h4>
    <pre><code>{`<EventCard href="/events/christmas-party" title="Senior Members Christmas Party"
  when="Wed, 9 December 2026, 6:00 pm — 8:00 pm" summary="…" image="/party.webp"
  entry={{ href: 'https://forms.gle/…', text: 'RSVP' }} countdown="5 days left to enter" />`}</code></pre>
  </section>

  <section id="news-card">
    <SectionHeading label="Components" title="News card" />
    <p class="note">A news post in a list. Made for white backgrounds: the text sits in a pale grey box. The whole card is one link, and the photo zooms in slightly on hover.</p>
    <div class="cards">
      <NewsCard href="#news-card" title="Olive Oil Fundraiser 2026" date="29 October 2026" summary="Village Press olive oil packs, $35 for 3 x 250ml bottles. Order by 23 November." image="/examples/olive-oil.webp" />
      <NewsCard href="#news-card" title="2026/27 Season Open Day" date="19 September 2026" summary="Join us for our 2026/27 Season Opening Day on Saturday September 19th." image="/examples/open-day.avif" />
      <NewsCard href="#news-card" title="Re-string with Rhys" date="18 May 2026" summary="Drop off and pick up at WTC. Approx 24-hour turnaround. A range of strings available." image="/examples/restring.avif" />
    </div>
    <h4>Use it</h4>
    <pre><code>{`<NewsCard href="/news/olive-oil-fundraiser-2026" title="Olive Oil Fundraiser 2026"
  date="29 October 2026" summary="…" image="/olive-oil.webp" />`}</code></pre>
  </section>

  <section id="person-card">
    <SectionHeading label="Components" title="Person card" />
    <p class="note">A person, built from the Avatar and Icon button. Four layouts: contact details on dark or light backgrounds, a coach in a grid, and a featured coach with a bio. With no photo, the initials show instead.</p>
    <h3>Contact</h3>
    <div class="demo dark top">
      <PersonCard variant="contact" name="Cassandra Hinton" role="Club manager" phone="021 0223 7650" email="admin@wtc.co.nz" />
      <PersonCard variant="contact" name="Rhys" role="Head coach" photo="/examples/rhys-picture.avif" phone="03 355 9611" email="headcoach@wtc.co.nz" />
    </div>
    <div class="demo light top">
      <PersonCard variant="contact-light" name="Cassandra Hinton" phone="021 0223 7650" email="admin@wtc.co.nz" />
    </div>
    <h3>Coaches</h3>
    <div class="demo white top">
      <div class="coach-feature">
        <PersonCard variant="coach-featured" name="Rhys" role="Head coach" photo="/examples/rhys-picture.avif" phone="03 355 9611" email="headcoach@wtc.co.nz" button={{ href: '#person-card', text: 'Book a lesson' }}>
          <p>A short bio goes here: experience, qualifications and what they coach.</p>
        </PersonCard>
      </div>
      <div class="coach-grid">
        <PersonCard variant="coach" name="Rhys" role="Head coach" photo="/examples/rhys-picture.avif" />
        <PersonCard variant="coach" name="New Coach" role="Coach" />
        <PersonCard variant="coach" name="Daiki" role="Coach" />
      </div>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<PersonCard variant="contact" name="Cassandra Hinton" role="Club manager"
  phone="021 0223 7650" email="admin@wtc.co.nz" photo={photo} />`}</code></pre>
  </section>

  <section id="membership-card">
    <SectionHeading label="Components" title="Membership card" />
    <p class="note">A membership option, as on the Membership page. Without a join link it shows a dark "opening soon" bar instead of the button.</p>
    <div class="stack">
      <MembershipCard name="Family" intro="1 adult and 3 kids, or 2 adults and 2 kids" price="999" join={{ href: '#membership-card', text: 'Family membership registration' }}>
        <ul><li>2026/27 season.</li><li>Use of all courts.</li><li>Social organised play all year.</li><li>Children must be under 18 years.</li></ul>
      </MembershipCard>
      <MembershipCard name="Hot Shots Red Ball" intro="Most suited for kids 5 – 8 years" price="215" openingSoon="HotShots Red Ball membership will be opening soon">
        <ul><li>Registration is for Terms 4 2026 and Term 1 2027.</li><li>Sessions are weekdays, Monday to Thursday at 3:40pm.</li></ul>
      </MembershipCard>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<MembershipCard name="Family" intro="2 adults and 2 kids" price="999"
  join={{ href: 'https://…', text: 'Join now' }}>
  <ul><li>Use of all courts</li></ul>
</MembershipCard>`}</code></pre>
  </section>

  <section id="subtitle">
    <SectionHeading label="Components" title="Subtitle" />
    <p class="note">The small line and label above a heading. It tells people where they are ("Join us", "Waimairi Tennis Club", a date) before the big heading.</p>
    <div class="demo">
      <figure><Subtitle>Join us</Subtitle><figcaption>tone="dark"</figcaption></figure>
    </div>
    <div class="demo dark">
      <figure><Subtitle tone="light">Waimairi Tennis Club</Subtitle><figcaption>tone="light"</figcaption></figure>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<Subtitle>Join us</Subtitle>
<h2 class="wtc-h2">Come along for a free trial</h2>`}</code></pre>
  </section>

  <section id="info-box">
    <SectionHeading label="Components" title="Info box" />
    <p class="note">The blue boxes on an event page. An icon, a heading and whatever goes inside: an address, dates, a contact or bank details.</p>
    <div class="info-boxes">
      <InfoBox icon="location" heading="Location"><p>Waimairi Tennis Club<br />49 Watford Street</p></InfoBox>
      <InfoBox icon="calendar" heading="Date"><p>Wednesday, 9 December 2026<br />6:00 pm — 8:00 pm</p></InfoBox>
      <InfoBox icon="info" heading="For more info"><p>Contact Cassandra Hinton on 021 0223 7650 or email <a href="mailto:admin@wtc.co.nz">admin@wtc.co.nz</a></p></InfoBox>
      <InfoBox icon="payment" heading="Payment details"><p>To register, please make payment to the account below and include your full name as the reference.<br />12-3209-0326080-00</p></InfoBox>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<InfoBox icon="location" heading="Location">
  <p>Waimairi Tennis Club, 49 Watford Street</p>
</InfoBox>`}</code></pre>
    <p class="note">Icons: calendar, location, info, payment, phone, email.</p>
  </section>

  <section id="filter">
    <SectionHeading label="Components" title="Category filter" />
    <p class="note">The category buttons above the Events and News lists. Tick one or more to narrow the list; ALL shows everything again. Try it below.</p>
    <div class="demo grey flush-pad">
      <div style="width: 100%">
        <CategoryFilter list="demo" label="Filter events:" categories={[{ id: 'juniors', name: 'Juniors' }, { id: 'seniors', name: 'Seniors' }, { id: 'social', name: 'Social' }, { id: 'interclub', name: 'Interclub' }]} />
        <div class="filter-list" data-filter-list="demo">
          <div data-categories="juniors">Junior Club Champs</div>
          <div data-categories="seniors social">Senior Christmas Party</div>
          <div data-categories="juniors social">Hot Shots Christmas Party</div>
          <div data-categories="seniors interclub">Senior Interclub</div>
        </div>
      </div>
    </div>
    <h4>Use it</h4>
    <pre><code>{`<CategoryFilter list="events" label="Filter events:" categories={categories} />
<div data-filter-list="events">
  <EventCard data-categories="juniors social" … />
</div>`}</code></pre>
  </section>

  <section id="sponsor">
    <SectionHeading label="Components" title="Sponsor logo" />
    <p class="note">A sponsor's logo on their own background colour, linking to their website. The logo shrinks a touch on hover.</p>
    <div class="sponsors">
      <SponsorLogo logo="/examples/sponsors/davis-ogilvie-logo.svg" alt="Davis Ogilvie" background="#191818" href="https://do.co.nz" />
      <SponsorLogo logo="/examples/sponsors/christchurch-city-council-logo.svg" alt="Christchurch City Council" href="https://ccc.govt.nz" />
      <SponsorLogo logo="/examples/sponsors/elmwood-dental-logo.svg" alt="Elmwood Dental" href="https://elmwooddental.co.nz" />
    </div>
    <h4>Use it</h4>
    <pre><code>{`<SponsorLogo logo="/davis-ogilvie.svg" alt="Davis Ogilvie" background="#191818" href="https://do.co.nz" />`}</code></pre>
  </section>
</Docs>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-20); margin-bottom: var(--space-16); }
  .cards.grey { background: var(--wtc-steel-200); padding: var(--space-30); }
  .stack { display: flex; flex-direction: column; gap: var(--space-40); margin-bottom: var(--space-16); }
  .coach-feature { flex: 0 1 360px; }
  .coach-grid { flex: 1 1 360px; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-40); }
  .info-boxes { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-14); margin-bottom: var(--space-16); }
  .sponsors { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-14); margin-bottom: var(--space-16); }
  .filter-list { display: flex; flex-wrap: wrap; gap: var(--space-8); margin-top: var(--space-20); }
  .filter-list > div { background: var(--color-white); padding: var(--space-8) var(--space-14); font-size: var(--text-15); }
  @media (max-width: 991px) {
    .cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .cards, .info-boxes, .sponsors { grid-template-columns: 1fr; }
    .cards.grey { padding: var(--space-16); }
  }
</style>
