---
// Foundations: logos, colours, type, spacing and icons, all read from tokens/ and assets/.
import Docs from '../layouts/Docs.astro';
import { palettes, group } from '../lib/tokens';

const logos = import.meta.glob<string>('../../assets/logos/*.svg', { eager: true, query: '?url', import: 'default' });
const icons = import.meta.glob<string>('../../assets/icons/*.svg', { eager: true, query: '?url', import: 'default' });
const fileName = (path: string) => path.split('/').pop()!;
// Show light-coloured artwork on a dark tile, judged by the colours inside the SVG.
const svgSource = import.meta.glob<string>(['../../assets/logos/*.svg', '../../assets/icons/*.svg'], { eager: true, query: '?raw', import: 'default' });
const isLight = (colour: string) => {
  const c = colour.toLowerCase();
  if (c === 'white') return true;
  const hex = c.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/)?.[1];
  if (!hex) return false;
  const full = hex.length === 3 ? [...hex].map(h => h + h).join('') : hex;
  const [r, g, b] = [0, 2, 4].map(i => parseInt(full.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 200;
};
const onDark = (path: string) => {
  const colours = [...svgSource[path].matchAll(/(?:fill|stroke)(?:=|:)\s*"?([#\w]+)/g)].map(m => m[1]).filter(c => c !== 'none' && c !== 'currentColor');
  return colours.length > 0 && colours.every(isLight);
};

const roles = group('Colour roles');
const hotshots = group('HotShots colours').filter(t => !t.name.endsWith('-dark'));
const spacing = group('Spacing');
const textSizes = group('Text sizes');
const weights = group('Type').filter(t => t.name.startsWith('--weight'));
const leading = group('Type').filter(t => t.name.startsWith('--leading'));
---
<Docs
  title="Foundations"
  intro="Logos, colours, type, spacing and icons for everything the club makes. Every value on this page is read from <code>tokens/tokens.css</code>, so it's always up to date."
  sections={[{ id: 'logos', label: 'Logos' }, { id: 'colours', label: 'Colours' }, { id: 'type', label: 'Type' }, { id: 'spacing', label: 'Spacing' }, { id: 'icons', label: 'Icons' }]}
>
      <section id="logos">
        <h2>Logos</h2>
        <div class="grid logos">
          {Object.entries(logos).map(([path, url]) => (
            <figure class:list={['tile', { dark: onDark(path) }]}>
              <img src={url} alt="" />
              <figcaption>{fileName(path)}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section id="colours">
        <h2>Colours</h2>
        <h3>Brand ranges</h3>
        {Object.entries(palettes).map(([name, tokens]) => (
          <div class="palette">
            <h4>{name}</h4>
            <div class="swatches">
              {tokens.map(t => (
                <div class="swatch">
                  <div class="chip" style={`background: var(${t.name})`}></div>
                  <code>{t.name.replace(`--wtc-${name}-`, '')}</code>
                  <span>{t.value}</span>
                </div>
              ))}
            </div>
          </div>
        ))}

        <h3>Colour roles</h3>
        <p class="note">Use these in designs and code rather than the range colours, so a role can be changed in one place.</p>
        <div class="grid roles">
          {roles.map(t => (
            <div class="role">
              <div class="chip" style={`background: var(${t.name})`}></div>
              <div><code>{t.name}</code><span>{t.value}</span></div>
            </div>
          ))}
        </div>

        <h3>Hot Shots</h3>
        <div class="grid roles">
          {hotshots.map(t => (
            <div class="role">
              <div class="chip" style={`background: var(${t.name})`}></div>
              <div><code>{t.name}</code><span>{t.value}</span></div>
            </div>
          ))}
        </div>
      </section>

      <section id="type">
        <h2>Type</h2>
        <p class="note">Barlow for everything (free, from Google Fonts).</p>
        <h3>Weights</h3>
        {weights.map(t => (
          <p class="sample" style={`font-weight: var(${t.name})`}>Game, set and match <code>{t.name} · {t.value}</code></p>
        ))}
        <h3>Sizes</h3>
        {[...textSizes].reverse().map(t => (
          <p class="size" style={`font-size: var(${t.name})`}>Waimairi Tennis Club <code>{t.name}</code></p>
        ))}
        <h3>Line heights</h3>
        <div class="grid leading">
          {leading.map(t => (
            <div class="tile text">
              <p style={`line-height: var(${t.name})`}>Junior and senior tennis for all ages and abilities, at Wilding Park and Watford Street.</p>
              <code>{t.name} · {t.value}</code>
            </div>
          ))}
        </div>
      </section>

      <section id="spacing">
        <h2>Spacing</h2>
        {spacing.map(t => (
          <div class="space">
            <code>{t.name}</code>
            <div class="bar" style={`width: var(${t.name})`}></div>
          </div>
        ))}
      </section>

      <section id="icons">
        <h2>Icons</h2>
        <div class="grid icons">
          {Object.entries(icons).map(([path, url]) => (
            <figure class:list={['tile', { dark: onDark(path) }]}>
              <img src={url} alt="" />
              <figcaption>{fileName(path)}</figcaption>
            </figure>
          ))}
        </div>
      </section>
</Docs>

<style>
  h4 { text-transform: capitalize; }

  .logos { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .icons { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .roles { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .leading { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

  .tile.text { align-items: stretch; }
  .tile.text p { margin: 0; }
  .logos img { height: 60px; max-width: 100%; }
  .icons img { height: 32px; max-width: 100%; }

  .palette { margin-bottom: var(--space-24); }
  .swatches { display: grid; grid-template-columns: repeat(11, 1fr); gap: var(--space-6); }
  .swatch { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .swatch .chip { height: 56px; border-radius: 6px; }
  .swatch span, .role span { font-size: var(--text-12); color: var(--color-info-text); overflow-wrap: anywhere; }
  .role { display: flex; gap: var(--space-12); align-items: center; }
  .role .chip { width: 48px; height: 48px; border-radius: 6px; flex-shrink: 0; border: 1px solid var(--color-border); }
  .role div:last-child { display: flex; flex-direction: column; min-width: 0; }
  .chip { box-shadow: inset 0 0 0 1px rgb(0 0 0 / 6%); }

  .sample { font-size: var(--text-26); margin: var(--space-8) 0; color: var(--color-heading); }
  .size { margin: var(--space-6) 0; color: var(--color-heading); line-height: var(--leading-small); overflow-wrap: anywhere; }
  .sample code, .size code { margin-left: var(--space-12); }

  .space { display: grid; grid-template-columns: 120px 1fr; align-items: center; gap: var(--space-12); margin-bottom: var(--space-6); }
  .bar { height: 14px; background: var(--color-accent); border-radius: 2px; }

  @media (max-width: 767px) {
    .swatches { grid-template-columns: repeat(6, 1fr); }
  }
</style>
