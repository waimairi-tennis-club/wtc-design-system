---
// A section heading the way the site does it: small "line + label" subtitle above a large heading.
import Subtitle from '../../components/Subtitle.astro';

interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---
<div>
  <Subtitle>{label}</Subtitle>
  <h2>{title}</h2>
</div>
